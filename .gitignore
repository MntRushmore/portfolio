# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design process artefacts (screenshots, recordings)
/.design/shots/
/.design/og/shot/
/.design/og/icon-*/
.gstack/

# Design process artefacts (renders, photos): keep only the notes
/.design/*
!/.design/*.md

# Local agent tooling
/.claude/
/.agents/

# Video tool assets: the SoundFont is >100 MB (re-download per tools/marble-video/assets/README.md)
/tools/marble-video/assets/*.sf2
